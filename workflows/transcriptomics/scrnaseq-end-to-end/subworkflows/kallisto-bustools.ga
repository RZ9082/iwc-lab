      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Kallisto-Bustools Reference",
        "id": "kb-ref",
        "version": "0.28.2",
        "description": "Generate kallisto index and transcript-to-gene mappings from genome FASTA and GTF",
        "container": "quay.io/biocontainers/kb-python:0.28.2--pyhdfd78af_2",
        "shell_command": "set -euo pipefail\nkb ref \\\n  -i kb_ref_out.idx \\\n  -g t2g.txt \\\n  -f1 cdna.fa \\\n  --workflow '$(inputs.workflow_mode || \"standard\")' \\\n  '$(inputs.fasta.path)' \\\n  '$(inputs.gtf.path)'\n",
        "inputs": [
          {
            "name": "fasta",
            "type": "data",
            "format": "fasta",
            "label": "Genome Reference FASTA"
          },
          {
            "name": "gtf",
            "type": "data",
            "format": "gtf",
            "label": "Gene Annotation GTF"
          },
          {
            "name": "workflow_mode",
            "type": "text",
            "value": "standard",
            "label": "Workflow Mode (standard, lamanno, nucleus)"
          }
        ],
        "outputs": [
          {
            "name": "index",
            "type": "data",
            "format": "binary",
            "from_work_dir": "kb_ref_out.idx",
            "label": "Kallisto Index (.idx)"
          },
          {
            "name": "t2g",
            "type": "data",
            "format": "tabular",
            "from_work_dir": "t2g.txt",
            "label": "Transcript-to-Gene Mapping (t2g.txt)"
          },
          {
            "name": "cdna",
            "type": "data",
            "format": "fasta",
            "from_work_dir": "cdna.fa",
            "label": "Extracted cDNA FASTA"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Builds a kallisto index and transcript-to-gene mapping (t2g) required for single-cell quantification with kb count."
        }
      }
    },
    "6": {
      "id": 6,
      "name": "Kallisto-Bustools Count",
      "type": "tool",
      "label": "kb_count",
      "annotation": "Quantify single-cell FASTQ reads against kallisto index",
      "tool_state": "{\"__page__\": 0}",
      "position": {
        "left": 810,
        "top": 50
      },
      "input_connections": {
        "reads": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "index": [
          {
            "id": 5,
            "output_name": "index"
          }
        ],
        "t2g": [
          {
            "id": 5,
            "output_name": "t2g"
          }
        ],
        "technology": [
