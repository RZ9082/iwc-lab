      "type_": "parameter_input",
      "label": "workflow_mode",
      "annotation": "Kallisto quantification mode (standard, lamanno, nucleus)",
      "tool_state": {
        "name": "workflow_mode",
        "parameter_type": "text",
        "default": "standard"
      },
      "position": {
        "top": 40,
        "left": 40
      },
      "input_connections": {},
      "inputs": [
        {
          "name": "workflow_mode",
          "description": ""
        }
      ],
      "outputs": [],
