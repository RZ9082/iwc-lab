    "3": {
      "id": 3,
      "name": "technology",
      "type_": "parameter_input",
      "label": "technology",
      "annotation": "Barcode chemistry (e.g. 10XV2, 10XV3, DROPSEQ)",
      "tool_state": {
        "name": "technology",
        "parameter_type": "text",
        "default": "10XV2"
