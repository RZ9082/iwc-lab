      "class": "Organization"
    }
  ],
  "comments": [],
  "steps": {
    "0": {
      "id": 0,
      "name": "genome_fasta",
      "type": "data_input",
      "label": "genome_fasta",
      "annotation": "Reference genome FASTA sequence file",
      "tool_state": "{\"name\": \"genome_fasta\", \"format\": [\"fasta\"]}",
      "position": {
        "left": 50,
        "top": 50
      },
      "input_connections": {},
      "inputs": [
        {
          "name": "genome_fasta",
          "description": ""
        }
      ],
      "outputs": [],
