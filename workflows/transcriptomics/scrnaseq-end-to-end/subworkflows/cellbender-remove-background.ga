      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "CellBender Remove Background",
        "id": "cellbender-remove-background",
        "version": "0.3.2",
        "description": "Eliminate ambient RNA and empty droplets from raw single-cell H5AD count matrices",
        "container": "quay.io/biocontainers/cellbender:0.3.2--pyhdfd78af_0",
        "shell_command": "set -euo pipefail\nln -sf '$(inputs.h5ad.path)' input.h5ad\ncellbender remove-background \\\n  --input input.h5ad \\\n  --output cellbender_out.h5 \\\n  --fpr $(inputs.fpr || 0.01) \\\n  --epochs $(inputs.epochs || 150) \\\n  --cpu-threads \\${GALAXY_SLOTS:-4}\n",
        "inputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "label": "Raw Unfiltered AnnData Matrix (H5AD)"
          },
          {
            "name": "fpr",
            "type": "float",
            "optional": true,
            "label": "Nominal False Positive Rate (FPR)"
          },
          {
            "name": "epochs",
            "type": "integer",
            "optional": true,
            "label": "Number of Training Epochs"
          }
        ],
        "outputs": [
          {
            "name": "barcodes",
            "type": "data",
            "format": "csv",
            "from_work_dir": "cellbender_out_cell_barcodes.csv",
            "label": "CellBender Filtered Cell Barcodes"
          },
          {
            "name": "filtered_h5",
            "type": "data",
            "format": "h5",
            "from_work_dir": "cellbender_out_filtered.h5",
            "label": "CellBender Filtered Count Matrix"
          },
          {
            "name": "metrics",
            "type": "data",
            "format": "csv",
            "from_work_dir": "cellbender_out_metrics.csv",
            "label": "CellBender Metrics Summary"
          },
          {
            "name": "pdf",
            "type": "data",
            "format": "pdf",
            "from_work_dir": "cellbender_out.pdf",
            "label": "CellBender Diagnostic Plots (PDF)"
          }
        ]
      }
    },
    "4": {
      "id": 4,
      "name": "Filter AnnData by Barcodes",
      "type": "tool",
      "label": "filter_barcodes",
      "annotation": "Subset AnnData matrix using CellBender verified barcodes",
      "tool_state": "{\"__page__\": 0}",
      "position": {
        "left": 810,
        "top": 50
      },
      "input_connections": {
        "h5ad": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "barcodes": [
          {
            "id": 3,
            "output_name": "barcodes"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "CellBender Filtered AnnData Matrix",
          "output_name": "filtered_h5ad"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Filter AnnData by Barcodes",
        "id": "anndata-barcodes",
        "version": "1.7.2",
        "description": "Subset an AnnData H5AD matrix using a list of valid cell barcodes",
        "container": "quay.io/biocontainers/scanpy:1.7.2--pyhdfd78af_0",
        "configfiles": [
          {
            "filename": "filter_barcodes.py",
            "content": "import sys\nimport pandas as pd\nimport anndata as ad\n\nbarcodes_file = sys.argv[1]\nh5ad_file = sys.argv[2]\nout_file = sys.argv[3]\n\nprint(f\"Reading barcodes from {barcodes_file}\")\ndf = pd.read_csv(barcodes_file, header=None)\nkeep_barcodes = set(df[0].astype(str).str.strip().values)\nprint(f\"Found {len(keep_barcodes)} valid cell barcodes\")\n\nprint(f\"Loading AnnData from {h5ad_file}\")\nadata = ad.read_h5ad(h5ad_file)\nprint(f\"Original shape: {adata.shape}\")\n\noverlap = set(adata.obs_names).intersection(keep_barcodes)\nif len(overlap) == 0:\n    if any(bc.endswith(\"-1\") for bc in keep_barcodes):\n        keep_barcodes = {bc.replace(\"-1\", \"\") for bc in keep_barcodes}\n    else:\n        keep_barcodes = {f\"{bc}-1\" for bc in keep_barcodes}\n    overlap = set(adata.obs_names).intersection(keep_barcodes)\n\nprint(f\"Matching barcodes: {len(overlap)}\")\nvalid_indices = [idx for idx, name in enumerate(adata.obs_names) if name in keep_barcodes]\nadata_filtered = adata[valid_indices].copy()\nprint(f\"Filtered shape: {adata_filtered.shape}\")\n\nadata_filtered.write_h5ad(out_file)\nprint(f\"Saved filtered AnnData to {out_file}\")\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 filter_barcodes.py '$(inputs.barcodes.path)' '$(inputs.h5ad.path)' filtered_cellbender.h5ad\n",
        "inputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "label": "Input AnnData Object (H5AD)"
          },
          {
            "name": "barcodes",
            "type": "data",
            "format": "csv",
            "label": "Whitelist Cell Barcodes (CSV)"
          }
        ],
        "outputs": [
          {
            "name": "filtered_h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "filtered_cellbender.h5ad",
            "label": "Barcode-Filtered AnnData Matrix (H5AD)"
          }
        ]
      }
    }
  }
