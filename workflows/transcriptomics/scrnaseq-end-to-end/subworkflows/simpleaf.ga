          "output_name": "index_archive"
        },
        {
          "label": "Simpleaf Transcript-to-Gene Mapping (t2g.tsv)",
          "output_name": "t2g"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Simpleaf Index",
        "id": "simpleaf-index",
        "version": "0.19.5",
        "description": "Build Piscem / Salmon reference index and transcript-to-gene mapping for single-cell quantification",
        "container": "quay.io/biocontainers/simpleaf:0.19.5--ha6fb395_0",
        "shell_command": "set -euo pipefail\nexport ALEVIN_FRY_HOME=\"$PWD/af_home\"\nmkdir -p \"$ALEVIN_FRY_HOME\"\nsimpleaf set-paths\nsimpleaf index \\\n  --threads \\${GALAXY_SLOTS:-4} \\\n  --fasta '$(inputs.fasta.path)' \\\n  --gtf '$(inputs.gtf.path)' \\\n  -o af_index\n\ntar -czf index.tar.gz -C af_index index ref\ncp af_index/ref/t2g_3col.tsv t2g.tsv 2>/dev/null || cp af_index/ref/t2g.tsv t2g.tsv 2>/dev/null || true\n",
        "inputs": [
          {
            "name": "fasta",
            "type": "data",
            "format": "fasta",
            "label": "Genome Reference FASTA"
          },
          {
            "name": "gtf",
            "type": "data",
            "format": "gtf",
            "label": "Gene Annotation GTF"
          }
        ],
        "outputs": [
          {
            "name": "index_archive",
            "type": "data",
            "format": "tar",
            "from_work_dir": "index.tar.gz",
            "label": "Simpleaf Index Archive (.tar.gz)"
          },
          {
            "name": "t2g",
            "type": "data",
            "format": "tabular",
            "from_work_dir": "t2g.tsv",
            "label": "Simpleaf Transcript-to-Gene Mapping (t2g.tsv)"
          }
        ]
      }
    },
    "7": {
      "id": 7,
      "name": "Simpleaf Quant",
      "type": "tool",
      "label": "simpleaf_quant",
      "annotation": "Quantify single-cell FASTQ reads with simpleaf quant",
      "tool_state": "{\"__page__\": 0}",
      "position": {
        "left": 810,
        "top": 50
      },
      "input_connections": {
        "reads": [
          {
            "id": 0,
            "output_name": "output"
          }
        ],
        "index_archive": [
          {
            "id": 6,
            "output_name": "index_archive"
          }
        ],
        "t2g": [
          {
            "id": 6,
            "output_name": "t2g"
          }
        ],
        "whitelist": [
          {
            "id": 3,
            "output_name": "output"
          }
        ],
        "chemistry": [
          {
            "id": 4,
            "output_name": "output"
          }
        ],
        "resolution": [
          {
            "id": 5,
            "output_name": "output"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "Simpleaf AnnData Matrix (H5AD)",
          "output_name": "h5ad"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Simpleaf Quant",
        "id": "simpleaf-quant",
        "version": "0.19.5",
        "description": "Quantify single-cell RNA-seq FASTQ reads using piscem/salmon mapping and alevin-fry",
        "container": "quay.io/biocontainers/simpleaf:0.19.5--ha6fb395_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\n  \"reads\": $(JSON.stringify(inputs.reads)),\n  \"index_archive\": $(JSON.stringify(inputs.index_archive.path)),\n  \"t2g\": $(JSON.stringify(inputs.t2g.path)),\n  \"whitelist\": $(JSON.stringify(inputs.whitelist.path)),\n  \"chemistry\": $(JSON.stringify(inputs.chemistry)),\n  \"resolution\": $(JSON.stringify(inputs.resolution))\n}\n"
          },
          {
            "filename": "run_simpleaf.py",
            "content": "import os\nimport sys\nimport json\nimport glob\nimport shutil\nimport subprocess\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nreads = params.get(\"reads\")\nfwd, rev = None, None\n\nif isinstance(reads, dict):\n    elements = reads.get(\"elements\", [])\n    if elements:\n        for el in elements:\n            ident = str(el.get(\"element_identifier\") or el.get(\"identifier\") or \"\")\n            p = el.get(\"path\")\n            if ident.lower() in [\"forward\", \"1\", \"r1\"]:\n                fwd = p\n            elif ident.lower() in [\"reverse\", \"2\", \"r2\"]:\n                rev = p\n        if not fwd and len(elements) > 0:\n            fwd = elements[0].get(\"path\")\n        if not rev and len(elements) > 1:\n            rev = elements[1].get(\"path\")\n    elif \"forward\" in reads and \"reverse\" in reads:\n        fwd = reads[\"forward\"].get(\"path\") if isinstance(reads[\"forward\"], dict) else reads[\"forward\"]\n        rev = reads[\"reverse\"].get(\"path\") if isinstance(reads[\"reverse\"], dict) else reads[\"reverse\"]\nelif isinstance(reads, list):\n    fwd = reads[0].get(\"path\") if isinstance(reads[0], dict) else reads[0]\n    rev = reads[1].get(\"path\") if isinstance(reads[1], dict) else reads[1]\n\nif not fwd or not rev:\n    print(f\"Error: Unable to identify forward and reverse read paths from input: {reads}\", file=sys.stderr)\n    sys.exit(1)\n\nos.environ[\"ALEVIN_FRY_HOME\"] = os.path.join(os.getcwd(), \"af_home\")\nos.makedirs(os.environ[\"ALEVIN_FRY_HOME\"], exist_ok=True)\nsubprocess.run([\"simpleaf\", \"set-paths\"], check=True)\n\nos.makedirs(\"af_index\", exist_ok=True)\nsubprocess.run([\"tar\", \"-xzf\", params[\"index_archive\"], \"-C\", \"af_index\"], check=True)\n\nslots = os.environ.get(\"GALAXY_SLOTS\", \"4\")\nchem = params.get(\"chemistry\") or \"10xv2\"\nres_mode = params.get(\"resolution\") or \"cr-like\"\n\ncmd = [\n    \"simpleaf\", \"quant\",\n    \"--threads\", str(slots),\n    \"--index\", \"af_index/index\",\n    \"--t2g-map\", params[\"t2g\"],\n    \"--chemistry\", chem,\n    \"--reads1\", fwd,\n    \"--reads2\", rev,\n    \"--unfiltered-pl\", params[\"whitelist\"],\n    \"--resolution\", res_mode,\n    \"--anndata-out\",\n    \"--output\", \"af_quant_out\"\n]\nprint(\"Running simpleaf quant:\", \" \".join(cmd))\nres = subprocess.run(cmd)\nif res.returncode != 0:\n    sys.exit(res.returncode)\n\nos.makedirs(\"out_quants\", exist_ok=True)\nfor p in glob.glob(\"af_quant_out/**/*.h5ad\", recursive=True):\n    shutil.copyfile(p, \"out_quants/quants.h5ad\")\n    break\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 run_simpleaf.py\n",
        "inputs": [
          {
            "name": "reads",
            "type": "data_collection",
            "collection_type": "paired",
            "label": "Paired Single-Cell Reads"
          },
          {
            "name": "index_archive",
            "type": "data",
            "format": "tar",
            "label": "Simpleaf Index Archive (.tar.gz)"
          },
          {
            "name": "t2g",
            "type": "data",
            "format": "tabular",
            "label": "Simpleaf Transcript-to-Gene Mapping (t2g.tsv)"
          },
          {
            "name": "whitelist",
            "type": "data",
            "format": "txt",
            "label": "Barcode Whitelist"
          },
          {
            "name": "chemistry",
            "type": "text",
            "value": "10xv2",
            "label": "Chemistry / Protocol"
          },
          {
            "name": "resolution",
            "type": "text",
            "value": "cr-like",
            "label": "UMI Resolution Strategy"
          }
        ],
        "outputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "out_quants/quants.h5ad",
            "label": "Simpleaf AnnData Matrix (H5AD)"
          }
        ]
      }
    },
    "8": {
      "id": 8,
      "name": "QCatch Quality Assessment",
      "type": "tool",
      "label": "qcatch",
      "annotation": "Evaluate quality metrics and filter empty droplets with QCatch",
      "tool_state": "{\"__page__\": 0}",
      "position": {
