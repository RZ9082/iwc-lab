      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Simpleaf Quant",
        "id": "simpleaf-quant",
        "version": "0.19.5",
        "description": "Quantify single-cell RNA-seq FASTQ reads using piscem/salmon mapping and alevin-fry",
        "container": "quay.io/biocontainers/simpleaf:0.19.5--ha6fb395_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\n  \"reads\": $(JSON.stringify(inputs.reads)),\n  \"index_archive\": $(JSON.stringify(inputs.index_archive.path)),\n  \"t2g\": $(JSON.stringify(inputs.t2g.path)),\n  \"whitelist\": $(JSON.stringify(inputs.whitelist.path)),\n  \"chemistry\": $(JSON.stringify(inputs.chemistry)),\n  \"resolution\": $(JSON.stringify(inputs.resolution))\n}\n"
          },
          {
            "filename": "run_simpleaf.py",
            "content": "import os\nimport sys\nimport json\nimport glob\nimport shutil\nimport subprocess\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nreads = params.get(\"reads\")\npaths = []\ndef find_paths(obj):\n    if isinstance(obj, str):\n        if obj.startswith(\"/\") or \".dat\" in obj or \"fastq\" in obj:\n            paths.append(obj)\n    elif isinstance(obj, dict):\n        if \"forward\" in obj and \"reverse\" in obj:\n            find_paths(obj[\"forward\"])\n            find_paths(obj[\"reverse\"])\n        elif \"1\" in obj and \"2\" in obj:\n            find_paths(obj[\"1\"])\n            find_paths(obj[\"2\"])\n        elif \"path\" in obj and isinstance(obj[\"path\"], str):\n            paths.append(obj[\"path\"])\n        else:\n            for k in sorted(obj.keys()):\n                find_paths(obj[k])\n    elif isinstance(obj, list):\n        for v in obj:\n            find_paths(v)\nfind_paths(reads)\nfwd = paths[0] if len(paths) > 0 else None\nrev = paths[1] if len(paths) > 1 else None\n\nif not fwd or not rev:\n    print(f\"Error: Unable to identify forward and reverse read paths from input: {reads}\", file=sys.stderr)\n    sys.exit(1)\n\nos.environ[\"ALEVIN_FRY_HOME\"] = os.path.join(os.getcwd(), \"af_home\")\nos.makedirs(os.environ[\"ALEVIN_FRY_HOME\"], exist_ok=True)\nsubprocess.run([\"simpleaf\", \"set-paths\"], check=True)\n\nos.makedirs(\"af_index\", exist_ok=True)\nsubprocess.run([\"tar\", \"-xzf\", params[\"index_archive\"], \"-C\", \"af_index\"], check=True)\n\nslots = os.environ.get(\"GALAXY_SLOTS\", \"4\")\nchem = params.get(\"chemistry\") or \"10xv2\"\nres_mode = params.get(\"resolution\") or \"cr-like\"\n\ncmd = [\n    \"simpleaf\", \"quant\",\n    \"--threads\", str(slots),\n    \"--index\", \"af_index/index\",\n    \"--t2g-map\", params[\"t2g\"],\n    \"--chemistry\", chem,\n    \"--reads1\", fwd,\n    \"--reads2\", rev,\n    \"--unfiltered-pl\", params[\"whitelist\"],\n    \"--resolution\", res_mode,\n    \"--anndata-out\",\n    \"--output\", \"af_quant_out\"\n]\nprint(\"Running simpleaf quant:\", \" \".join(cmd))\nres = subprocess.run(cmd)\nif res.returncode != 0:\n    sys.exit(res.returncode)\n\nos.makedirs(\"out_quants\", exist_ok=True)\nfor p in glob.glob(\"af_quant_out/**/*.h5ad\", recursive=True):\n    shutil.copyfile(p, \"out_quants/quants.h5ad\")\n    break\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 run_simpleaf.py\n",
        "inputs": [
          {
            "name": "reads",
            "type": "data_collection",
            "collection_type": "paired",
            "label": "Paired Single-Cell Reads"
          },
          {
            "name": "index_archive",
            "type": "data",
            "format": "tar",
            "label": "Simpleaf Index Archive (.tar.gz)"
          },
          {
            "name": "t2g",
            "type": "data",
            "format": "tabular",
            "label": "Simpleaf Transcript-to-Gene Mapping (t2g.tsv)"
          },
          {
            "name": "whitelist",
            "type": "data",
            "format": "txt",
            "label": "Barcode Whitelist"
          },
          {
            "name": "chemistry",
            "type": "text",
            "value": "10xv2",
            "label": "Chemistry / Protocol"
          },
          {
            "name": "resolution",
            "type": "text",
            "value": "cr-like",
            "label": "UMI Resolution Strategy"
          }
        ],
        "outputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "out_quants/quants.h5ad",
            "label": "Simpleaf AnnData Matrix (H5AD)"
          }
        ]
      }
    },
