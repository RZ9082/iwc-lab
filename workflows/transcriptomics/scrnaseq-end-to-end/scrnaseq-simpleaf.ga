      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Simpleaf Quant",
        "id": "simpleaf-quant",
        "version": "0.19.5",
        "description": "Quantify single-cell RNA-seq FASTQ reads using piscem/salmon mapping and alevin-fry",
        "container": "quay.io/biocontainers/simpleaf:0.19.5--ha6fb395_0",
        "shell_command": "set -euo pipefail\nexport ALEVIN_FRY_HOME=\"$PWD/af_home\"\nmkdir -p \"$ALEVIN_FRY_HOME\"\nsimpleaf set-paths\n\nmkdir -p af_index\ntar -xzf '$(inputs.index_archive.path)' -C af_index\n\nsimpleaf quant \\\n  --threads \\${GALAXY_SLOTS:-4} \\\n  --index af_index/index \\\n  --t2g-map '$(inputs.t2g.path)' \\\n  --chemistry 10xv2 \\\n  --reads1 '$(inputs.reads.forward.path)' \\\n  --reads2 '$(inputs.reads.reverse.path)' \\\n  --unfiltered-pl '$(inputs.whitelist.path)' \\\n  --resolution cr-like \\\n  --anndata-out \\\n  --output af_quant_out\n\nmkdir -p out_quants\nfind af_quant_out -name \"*.h5ad\" -exec cp {} out_quants/quants.h5ad \\;\n",
        "inputs": [
