    "5": {
      "id": 5,
      "name": "Filter GTF by Genome Sequences",
      "type_": "tool",
      "label": "filter_gtf",
      "annotation": "Filter GTF file to include only annotations on sequences present in reference FASTA",
      "tool_state": {
        "__page__": 0
      },
      "position": {
        "top": 50,
        "left": 50
      },
      "input_connections": {
        "fasta": [
          {
            "id": 1,
            "output_name": "output"
          }
        ],
        "gtf": [
          {
            "id": 2,
            "output_name": "output"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "Filtered Gene Annotation GTF",
          "output_name": "filtered_gtf"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Filter GTF by Genome Sequences",
        "id": "gtf-gene-filter",
        "version": "0.1.0",
        "description": "Filter GTF file to include only annotations on sequences present in reference FASTA",
        "container": "quay.io/biocontainers/python:3.13",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\"fasta\": $(JSON.stringify(inputs.fasta.path)), \"gtf\": $(JSON.stringify(inputs.gtf.path))}\n"
          },
          {
            "filename": "filter_gtf.py",
            "content": "import json\nfrom itertools import groupby\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\ndef is_header(line):\n    return line.startswith(\">\")\n\ndef extract_fasta_seq_names(fasta_name):\n    with open(fasta_name) as fh:\n        faiter = (x[1] for x in groupby(fh, is_header))\n        for header in faiter:\n            line = next(header)\n            if is_header(line):\n                yield line[1:].strip().split()[0]\n\nseq_names = set(extract_fasta_seq_names(params[\"fasta\"]))\nwith open(params[\"gtf\"]) as in_handle, open(\"filtered.gtf\", \"w\") as out_handle:\n    for line in in_handle:\n        if line.startswith(\"#\"):\n            out_handle.write(line)\n        else:\n            fields = line.split(\"\\t\")\n            if fields[0] in seq_names:\n                out_handle.write(line)\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 filter_gtf.py\n",
        "inputs": [
          {
            "name": "fasta",
            "type": "data",
            "format": "fasta",
            "label": "Reference Genome FASTA"
          },
          {
            "name": "gtf",
            "type": "data",
            "format": "gtf",
            "label": "Gene Annotation GTF"
          }
        ],
        "outputs": [
          {
            "name": "filtered_gtf",
            "type": "data",
            "format": "gtf",
            "from_work_dir": "filtered.gtf",
            "label": "Filtered Gene Annotation GTF"
          }
        ]
      }
    },
