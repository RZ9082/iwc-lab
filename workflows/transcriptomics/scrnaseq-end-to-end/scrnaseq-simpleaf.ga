{
  "name": "Single-Cell RNA-Seq Pipeline: Simpleaf / Alevin-fry (QCatch, AnnData, Seurat, SingleCellExperiment, MultiQC)",
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "annotation": "This workflow performs single-cell RNA-seq alignment and quantification using Simpleaf (Piscem/Salmon and Alevin-fry),\nfollowed by QCatch empty droplet QC, AnnData generation, multi-sample concatenation,\nSeurat and SingleCellExperiment format conversion, and MultiQC reporting matching the simpleaf branch of nf-core/scrnaseq.\n",
  "tags": [
    "single-cell",
    "transcriptomics",
    "simpleaf",
    "alevin-fry",
    "anndata",
    "seurat",
    "nf-core",
    "nf-core/scrnaseq"
  ],
  "license": "MIT",
  "release": "0.1.0",
  "uuid": "1a39bc37-17bf-4099-9c58-deb8255ae342",
  "creator": [
    {
      "name": "nf-core",
      "url": "https://nf-co.re/scrnaseq",
      "class": "Organization"
    },
    {
      "name": "Rand Zoabi",
      "email": "rand.zoabi@rz.uni-freiburg.de",
      "class": "Person"
    },
    {
      "name": "Intergalactic Workflow Commission",
      "url": "https://github.com/galaxyproject/iwc",
      "class": "Organization"
    }
  ],
