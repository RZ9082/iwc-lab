          "label": "Combined Seurat RDS Object",
          "output_name": "seurat_rds"
        },
        {
          "label": "Combined SingleCellExperiment RDS Object",
          "output_name": "sce_rds"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Convert AnnData H5AD to Seurat and SingleCellExperiment",
        "id": "anndatar-convert",
        "version": "0.1.0",
        "description": "Convert an AnnData H5AD object into Seurat and SingleCellExperiment RDS formats",
        "container": "community.wave.seqera.io/library/bioconductor-anndatar_bioconductor-rhdf5_bioconductor-singlecellexperiment_r-seurat:a0f51df063bb9b2a",
        "configfiles": [
          {
            "filename": "convert.R",
            "content": "library(anndataR)\nlibrary(SeuratObject)\nlibrary(SingleCellExperiment)\n\ninput_path <- \"$(inputs.h5ad.path)\"\ncat(\"Reading AnnData H5AD from:\", input_path, \"\\n\")\nadata <- read_h5ad(input_path)\n\ncat(\"Converting to Seurat object...\\n\")\nobj_seurat <- adata$as_Seurat()\nsaveRDS(obj_seurat, file = \"matrix.seurat.rds\")\ncat(\"Saved matrix.seurat.rds\\n\")\n\ncat(\"Converting to SingleCellExperiment object...\\n\")\nobj_sce <- adata$as_SingleCellExperiment()\nsaveRDS(obj_sce, file = \"matrix.sce.rds\")\ncat(\"Saved matrix.sce.rds\\n\")\n"
          }
        ],
        "shell_command": "Rscript convert.R",
        "inputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "label": "AnnData Input Matrix (H5AD)"
          }
        ],
        "outputs": [
          {
            "name": "seurat_rds",
            "type": "data",
            "format": "rds",
            "from_work_dir": "matrix.seurat.rds",
            "label": "Seurat RDS Object"
          },
          {
