    "8": {
      "id": 8,
      "name": "Convert 10x MTX to AnnData H5AD",
      "type": "tool",
      "label": "mtx_to_h5ad",
      "annotation": "Convert 10x Genomics MTX outputs into per-sample AnnData H5AD format",
      "tool_state": "{\"__page__\": 0}",
      "position": {
        "left": 1190,
        "top": 50
      },
      "input_connections": {
        "matrix": [
          {
            "id": 7,
            "output_name": "output_matrix_filtered"
          }
        ],
        "barcodes": [
          {
            "id": 7,
            "output_name": "output_barcodes_filtered"
          }
        ],
        "features": [
          {
            "id": 7,
            "output_name": "output_genes_filtered"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "Per-Sample Filtered AnnData Matrix",
          "output_name": "h5ad"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Convert 10x MTX to AnnData H5AD",
        "id": "mtx-to-h5ad",
        "version": "0.1.0",
        "description": "Convert 10x Genomics MTX matrix, barcodes, and features into an AnnData H5AD object",
        "container": "quay.io/biocontainers/scanpy:1.7.2--pyhdfd78af_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\n  \"matrix\": $(JSON.stringify(inputs.matrix.path)),\n  \"barcodes\": $(JSON.stringify(inputs.barcodes.path)),\n  \"features\": $(JSON.stringify(inputs.features.path)),\n  \"sample\": $(JSON.stringify(inputs.sample_name)),\n  \"input_type\": $(JSON.stringify(inputs.input_type))\n}\n"
          },
          {
            "filename": "convert.py",
            "content": "import os\nimport json\nimport gzip\nimport shutil\nimport scanpy as sc\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nsample = params.get(\"sample\") or \"sample\"\ninput_type = params.get(\"input_type\") or \"filtered\"\n\nmtx_dir = \"solo_mtx_input\"\nos.makedirs(mtx_dir, exist_ok=True)\n\ndef setup_input(src, base_name):\n    dest_gz = os.path.join(mtx_dir, f\"{base_name}.gz\")\n    if os.path.exists(dest_gz):\n        os.remove(dest_gz)\n    with open(src, \"rb\") as f:\n        magic = f.read(2)\n    if magic == b\"\\x1f\\x8b\":\n        os.symlink(os.path.abspath(src), dest_gz)\n    else:\n        with open(src, \"rb\") as f_in, gzip.open(dest_gz, \"wb\") as f_out:\n            shutil.copyfileobj(f_in, f_out)\n\nsetup_input(params[\"matrix\"], \"matrix.mtx\")\nsetup_input(params[\"barcodes\"], \"barcodes.tsv\")\n\nfeat_src = params[\"features\"]\nwith open(feat_src, \"rb\") as f:\n    is_gz = f.read(2) == b\"\\x1f\\x8b\"\nif is_gz:\n    with gzip.open(feat_src, \"rt\") as f:\n        lines = f.readlines()\nelse:\n    with open(feat_src, \"rt\") as f:\n        lines = f.readlines()\n\nfirst_cols = lines[0].strip().split(\"\\t\") if lines else []\nif len(first_cols) == 1:\n    print(\"Detected 1-column features list (Kallisto/Bustools format). Reading directly via sc.read_mtx...\")\n    adata = sc.read_mtx(params[\"matrix\"])\n    barcodes_src = params[\"barcodes\"]\n    with open(barcodes_src, \"rb\") as bf:\n        b_gz = bf.read(2) == b\"\\x1f\\x8b\"\n    if b_gz:\n        with gzip.open(barcodes_src, \"rt\") as bf:\n            barcodes_list = [l.strip() for l in bf if l.strip()]\n    else:\n        with open(barcodes_src, \"rt\") as bf:\n            barcodes_list = [l.strip() for l in bf if l.strip()]\n    features_list = [l.strip() for l in lines if l.strip()]\n    if adata.shape == (len(barcodes_list), len(features_list)):\n        adata.obs_names = barcodes_list\n        adata.var_names = features_list\n    elif adata.shape == (len(features_list), len(barcodes_list)):\n        adata = adata.T\n        adata.obs_names = barcodes_list\n        adata.var_names = features_list\n    else:\n        print(f\"Warning: dimension mismatch {adata.shape} vs ({len(barcodes_list)}, {len(features_list)})\")\n        adata.obs_names = [f\"cell_{i}\" for i in range(adata.n_obs)]\n        adata.var_names = [f\"gene_{i}\" for i in range(adata.n_vars)]\n    adata.obs[\"sample\"] = sample\n    adata.layers[\"count\"] = adata.X.copy()\n    adata.var[\"gene_ids\"] = adata.var_names\n    adata.var[\"gene_symbol\"] = adata.var_names\n    adata.var[\"gene_versions\"] = adata.var_names\n    adata.var.index = adata.var[\"gene_versions\"].str.split(\".\").str[0].values\n    adata.var_names_make_unique()\nelse:\n    setup_input(feat_src, \"features.tsv\")\n    print(f\"Reading 10x MTX from {mtx_dir} for sample {sample} ({input_type})...\")\n    adata = sc.read_10x_mtx(mtx_dir)\n    adata.obs[\"sample\"] = sample\n    adata.layers[\"count\"] = adata.X.copy()\n    adata.var[\"gene_symbol\"] = adata.var.index\n    adata.var[\"gene_versions\"] = adata.var[\"gene_ids\"]\n    adata.var.index = adata.var[\"gene_versions\"].str.split(\".\").str[0].values\n    adata.var_names_make_unique()\n\nout_file = \"matrix.h5ad\"\nadata.write_h5ad(out_file)\nprint(f\"Successfully wrote AnnData ({adata.n_obs} cells x {adata.n_vars} genes) to {out_file}\")\n"
          }
        ],
        "shell_command": "python convert.py",
        "inputs": [
          {
            "name": "matrix",
            "type": "data",
            "format": "mtx",
            "label": "Count Matrix (MTX)"
          },
          {
            "name": "barcodes",
            "type": "data",
            "format": "tabular,txt",
            "label": "Barcodes (TSV)"
          },
          {
            "name": "features",
            "type": "data",
            "format": "tabular,txt",
            "label": "Features / Genes (TSV)"
          },
          {
            "name": "sample_name",
            "type": "text",
            "value": "sample",
            "label": "Sample Identifier"
          },
          {
            "name": "input_type",
            "type": "text",
            "value": "filtered",
            "label": "Matrix Type (raw or filtered)"
          }
        ],
        "outputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "matrix.h5ad",
            "label": "AnnData Matrix (H5AD)"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Converts 10x Genomics format MTX files (matrix.mtx, barcodes.tsv, features.tsv)\ninto a standardized AnnData H5AD dataset.\n\nThis tool matches the `MTX_TO_H5AD` module from `nf-core/scrnaseq`.\n"
        }
      }
    },
    "9": {
      "id": 9,
      "name": "Concatenate AnnData H5AD Files",
      "type": "tool",
      "label": "concat_h5ad",
      "annotation": "Concatenate multiple AnnData H5AD files into a merged dataset and optionally join metadata",
      "tool_state": "{\"__page__\": 0}",
      "position": {
        "left": 1570,
        "top": 50
      },
      "input_connections": {
        "h5ad_files": [
          {
            "id": 8,
            "output_name": "h5ad"
          }
        ],
        "samplesheet": [
          {
            "id": 4,
            "output_name": "output"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "Combined Filtered AnnData Matrix",
          "output_name": "combined_h5ad"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Concatenate AnnData H5AD Files",
        "id": "concat-h5ad",
        "version": "0.1.0",
        "description": "Combine multiple per-sample AnnData H5AD files into a merged dataset",
        "container": "quay.io/biocontainers/scanpy:1.7.2--pyhdfd78af_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\n  \"h5ads\": $(JSON.stringify((function() {\n    var files = inputs.h5ad_files;\n    if (files && files.elements) {\n      return files.elements.map(function(d) {\n        return {path: d.path, name: d.element_identifier || d.basename || \"sample\"};\n      });\n    } else if (Array.isArray(files)) {\n      return files.map(function(d) {\n        return {path: d.path, name: d.name || \"sample\"};\n      });\n    } else if (files && files.path) {\n      return [{path: files.path, name: files.name || \"sample\"}];\n    } else {\n      return [];\n    }\n  })())),\n  \"samplesheet\": $(JSON.stringify(inputs.samplesheet ? inputs.samplesheet.path : null)),\n  \"input_type\": $(JSON.stringify(inputs.input_type || \"filtered\"))\n}\n"
          },
          {
            "filename": "concat.py",
            "content": "import os\nimport json\nfrom pathlib import Path\nimport pandas as pd\nimport scanpy as sc\nimport anndata as ad\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\ninput_type = params.get(\"input_type\") or \"filtered\"\nsamplesheet_path = params.get(\"samplesheet\")\n\ndict_of_h5ad = {}\nfor item in params[\"h5ads\"]:\n    p = item[\"path\"]\n    adata_sub = sc.read_h5ad(p)\n    # Infer sample name from adata.obs['sample'] or fallback to item name\n    if \"sample\" in adata_sub.obs.columns and len(adata_sub.obs[\"sample\"]) > 0:\n        sample_name = str(adata_sub.obs[\"sample\"].iloc[0])\n    else:\n        sample_name = os.path.splitext(os.path.basename(item.get(\"name\") or \"sample\"))[0]\n    key = f\"{sample_name}_{input_type}\"\n    dict_of_h5ad[key] = adata_sub\n\nprint(f\"Concatenating {len(dict_of_h5ad)} AnnData datasets: {list(dict_of_h5ad.keys())}...\")\nadata = ad.concat(dict_of_h5ad, label=\"sample\", merge=\"unique\", index_unique=\"_\")\n\nif samplesheet_path and os.path.exists(samplesheet_path):\n    try:\n        sep = \",\" if samplesheet_path.endswith(\".csv\") else \"\\t\"\n        df_samplesheet = pd.read_csv(samplesheet_path, sep=sep)\n        if \"sample\" in df_samplesheet.columns:\n            df_samplesheet = df_samplesheet.groupby([\"sample\"]).agg(lambda col: \",\".join(set(col.astype(str))))\n            adata.obs = adata.obs.join(df_samplesheet, on=\"sample\", how=\"left\").astype(str)\n            print(\"Joined samplesheet metadata into AnnData obs.\")\n    except Exception as e:\n        print(f\"Warning: could not process samplesheet: {e}\")\n\nout_file = \"combined_matrix.h5ad\"\nadata.write_h5ad(out_file)\nprint(f\"Successfully wrote combined AnnData ({adata.n_obs} cells x {adata.n_vars} genes) to {out_file}\")\n"
          }
        ],
        "shell_command": "python concat.py",
        "inputs": [
          {
            "name": "h5ad_files",
            "type": "data_collection",
            "collection_type": "list",
