      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Matrix Market to AnnData H5AD",
        "id": "mtx-to-h5ad",
        "version": "1.7.2",
        "description": "Convert 10x Genomics Matrix Market files (matrix.mtx, barcodes.tsv, features.tsv) into an AnnData H5AD object",
        "container": "quay.io/biocontainers/scanpy:1.7.2--pyhdfd78af_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\"matrix\": $(JSON.stringify(inputs.matrix.path)), \"barcodes\": $(JSON.stringify(inputs.barcodes.path)), \"features\": $(JSON.stringify(inputs.features.path))}\n"
          },
          {
            "filename": "convert.py",
            "content": "import os\nimport gzip\nimport json\nimport scanpy as sc\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nos.makedirs(\"solo_mtx_input\", exist_ok=True)\nfor key, target_name in [(\"matrix\", \"matrix.mtx\"), (\"barcodes\", \"barcodes.tsv\"), (\"features\", \"features.tsv\")]:\n    src = params[key]\n    dst = os.path.join(\"solo_mtx_input\", target_name)\n    with open(src, \"rb\") as f_in, gzip.open(dst + \".gz\", \"wb\") as f_out:\n        f_out.writelines(f_in)\n\nadata = sc.read_10x_mtx(\"solo_mtx_input\", var_names=\"gene_symbols\", make_unique=True, cache=False)\nadata.write_h5ad(\"matrix.h5ad\")\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 convert.py\n",
        "inputs": [
          {
            "name": "matrix",
            "type": "data",
            "format": "mtx",
            "label": "Expression Matrix (MTX)"
          },
          {
            "name": "barcodes",
            "type": "data",
            "format": "tsv",
            "label": "Cell Barcodes (TSV)"
          },
          {
            "name": "features",
            "type": "data",
            "format": "tsv",
            "label": "Gene Features (TSV)"
          }
        ],
        "outputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "matrix.h5ad",
            "label": "AnnData Object (H5AD)"
          }
        ]
      }
    },
