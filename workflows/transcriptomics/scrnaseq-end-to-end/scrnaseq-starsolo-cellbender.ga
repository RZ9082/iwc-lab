      "tool_state": "{\"__page__\": 0, \"algo\": {\"params\": {\"settingsType\": \"default\"}}, \"chimOutType\": \"\", \"outWig\": {\"outWigStrand\": \"false\", \"outWigType\": \"None\"}, \"refGenomeSource\": {\"geneSource\": \"history\", \"genomeFastaFiles\": {\"__class__\": \"ConnectedValue\"}, \"genomeSAindexNbases\": 12, \"sjdbGTFfeatureExon\": \"exon\", \"sjdbGTFfile\": {\"__class__\": \"ConnectedValue\"}, \"sjdbOverhang\": 100}, \"sc\": {\"input_types\": {\"input_collection\": {\"__class__\": \"ConnectedValue\"}, \"use\": \"list_paired\"}, \"params\": {\"chemistry\": \"Cv2\"}, \"soloBarcodeReadLength\": true, \"soloCBmatchWLtype\": \"1MM_multi\", \"soloCBwhitelist\": {\"__class__\": \"ConnectedValue\"}, \"solo_type\": \"CB_UMI_Simple\", \"umidedup\": {\"soloUMIdedup\": \"1MM_CR\", \"soloUMIfiltering\": \"-\"}}, \"solo\": {\"filter\": {\"filter_type\": \"cellranger2\", \"n_expected\": 5000, \"max_perc\": 0.99, \"max_min_ratio\": 10.0, \"output_raw\": true}, \"outSAMattributes\": [\"NH\", \"HI\", \"AS\", \"nM\", \"GX\", \"GN\", \"CB\", \"UB\"], \"outSAMmapqUnique\": 60, \"outSAMunmapped\": false, \"quantModeGene\": true, \"soloFeatures\": \"Gene$\", \"soloOutFormatFeaturesGeneField3\": \"Gene Expression\", \"soloStrand\": \"Forward\", \"wasp_conditional\": {\"waspOutputMode\": \"\"}}}",
