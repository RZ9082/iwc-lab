{
  "name": "Single-Cell RNA-Seq Pipeline: STARsolo with CellBender Ambient RNA Removal",
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "annotation": "This workflow performs single-cell RNA-seq alignment with STARsolo, followed by CellBender deep generative\nambient RNA and empty droplet removal, AnnData concatenation, Seurat and SingleCellExperiment conversion,\nand MultiQC reporting matching the complete CellBender branch of nf-core/scrnaseq.\n",
  "tags": [
    "single-cell",
    "transcriptomics",
    "star",
    "cellbender",
    "anndata",
    "seurat",
    "nf-core",
    "nf-core/scrnaseq"
  ],
