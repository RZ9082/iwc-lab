        "container": "quay.io/biocontainers/scanpy:1.7.2--pyhdfd78af_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\"samplesheet\": $(JSON.stringify(inputs.samplesheet ? inputs.samplesheet.path : null)), \"h5ad_files\": $(JSON.stringify(inputs.h5ad_files.elements.map(function(e) { return {\"identifier\": e.element_identifier, \"path\": e.path}; })))}\n"
          },
          {
            "filename": "concat.py",
            "content": "import os\nimport json\nimport pandas as pd\nimport scanpy as sc\nimport anndata as ad\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nsheet_path = params.get(\"samplesheet\")\nh5ad_entries = params.get(\"h5ad_files\", [])\n\nadatas = []\nfor item in h5ad_entries:\n    p = item[\"path\"]\n    sample_name = item.get(\"identifier\") or os.path.basename(p).split(\".\")[0]\n    adata = sc.read_h5ad(p)\n    adata.obs[\"sample\"] = sample_name\n    adatas.append(adata)\n\nif len(adatas) == 1:\n    combined = adatas[0]\nelse:\n    combined = ad.concat(adatas, join=\"outer\", label=\"batch\", keys=[item.get(\"identifier\") for item in h5ad_entries])\n\nif sheet_path and os.path.exists(sheet_path):\n    try:\n        df = pd.read_csv(sheet_path)\n        if \"sample\" in df.columns:\n            meta_dict = df.set_index(\"sample\").to_dict(orient=\"index\")\n            for col in df.columns:\n                if col != \"sample\":\n                    combined.obs[col] = combined.obs[\"sample\"].map(lambda s: meta_dict.get(s, {}).get(col))\n    except Exception as e:\n        print(\"Warning: could not merge samplesheet:\", e)\n\ncombined.write_h5ad(\"combined.h5ad\")\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 concat.py\n",
        "inputs": [
          {
            "name": "h5ad_files",
            "type": "data_collection",
            "collection_type": "list",
            "label": "Input H5AD Files"
          },
          {
            "name": "samplesheet",
            "type": "data",
            "format": "csv",
            "optional": true,
            "label": "Samplesheet CSV"
          }
        ],
        "outputs": [
          {
            "name": "combined_h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "combined.h5ad",
            "label": "Combined AnnData Matrix (H5AD)"
          }
        ]
      }
    },
