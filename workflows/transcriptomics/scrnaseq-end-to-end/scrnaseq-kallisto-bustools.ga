      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Kallisto-Bustools Count",
        "id": "kb-count",
        "version": "0.28.2",
        "description": "Quantify single-cell RNA-seq FASTQ reads using kallisto and bustools",
        "container": "quay.io/biocontainers/kb-python:0.28.2--pyhdfd78af_2",
        "shell_command": "set -euo pipefail\nkb count \\\n  -t \\${GALAXY_SLOTS:-4} \\\n  -i '$(inputs.index.path)' \\\n  -g '$(inputs.t2g.path)' \\\n  -x 10XV2 \\\n  --workflow standard \\\n  -o output_counts \\\n  '$(inputs.reads.forward.path)' '$(inputs.reads.reverse.path)'\n\nmkdir -p out_solo/raw out_solo/filtered\nif [ -d output_counts/counts_unfiltered ]; then\n  cp output_counts/counts_unfiltered/*.mtx out_solo/raw/matrix.mtx 2>/dev/null || true\n  cp output_counts/counts_unfiltered/*.barcodes.txt out_solo/raw/barcodes.tsv 2>/dev/null || true\n  cp output_counts/counts_unfiltered/*.genes.txt out_solo/raw/features.tsv 2>/dev/null || true\nfi\nif [ -d output_counts/counts_filtered ]; then\n  cp output_counts/counts_filtered/*.mtx out_solo/filtered/matrix.mtx 2>/dev/null || true\n  cp output_counts/counts_filtered/*.barcodes.txt out_solo/filtered/barcodes.tsv 2>/dev/null || true\n  cp output_counts/counts_filtered/*.genes.txt out_solo/filtered/features.tsv 2>/dev/null || true\nfi\n",
        "inputs": [
          {
            "name": "reads",
            "type": "data_collection",
            "collection_type": "paired",
            "label": "Paired Single-Cell Reads"
          },
          {
            "name": "index",
            "type": "data",
            "format": "binary",
            "label": "Kallisto Index (.idx)"
          },
          {
            "name": "t2g",
