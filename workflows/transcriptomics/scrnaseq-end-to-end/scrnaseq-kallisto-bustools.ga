{
  "name": "Single-Cell RNA-Seq Pipeline: Kallisto-Bustools (AnnData, Seurat, SingleCellExperiment, MultiQC)",
  "a_galaxy_workflow": "true",
  "format-version": "0.1",
  "annotation": "This workflow performs single-cell RNA-seq pseudoalignment and quantification using kallisto and bustools (kb-python),\nfollowed by AnnData generation, multi-sample concatenation, Seurat and SingleCellExperiment format conversion,\nand MultiQC reporting matching the kallisto branch of nf-core/scrnaseq.\n",
  "tags": [
    "single-cell",
    "transcriptomics",
    "kallisto",
    "bustools",
    "anndata",
    "seurat",
    "nf-core",
    "nf-core/scrnaseq"
  ],
  "license": "MIT",
  "release": "0.1.0",
  "uuid": "60dbf0bf-b7fd-424a-bc91-1de66bfc2228",
