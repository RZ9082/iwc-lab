      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Kallisto-Bustools Count",
        "id": "kb-count",
        "version": "0.28.2",
        "description": "Quantify single-cell RNA-seq FASTQ reads using kallisto and bustools",
        "container": "quay.io/biocontainers/kb-python:0.28.2--pyhdfd78af_2",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\n  \"reads\": $(JSON.stringify(inputs.reads)),\n  \"index\": $(JSON.stringify(inputs.index.path)),\n  \"t2g\": $(JSON.stringify(inputs.t2g.path)),\n  \"whitelist\": $(JSON.stringify(inputs.whitelist ? inputs.whitelist.path : null)),\n  \"technology\": $(JSON.stringify(inputs.technology)),\n  \"workflow_mode\": $(JSON.stringify(inputs.workflow_mode))\n}\n"
          },
          {
            "filename": "run_kb.py",
            "content": "import os\nimport sys\nimport json\nimport glob\nimport shutil\nimport subprocess\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nreads = params.get(\"reads\")\npaths = []\ndef find_paths(obj):\n    if isinstance(obj, str):\n        if obj.startswith(\"/\") or \".dat\" in obj or \"fastq\" in obj:\n            paths.append(obj)\n    elif isinstance(obj, dict):\n        if \"forward\" in obj and \"reverse\" in obj:\n            find_paths(obj[\"forward\"])\n            find_paths(obj[\"reverse\"])\n        elif \"1\" in obj and \"2\" in obj:\n            find_paths(obj[\"1\"])\n            find_paths(obj[\"2\"])\n        elif \"path\" in obj and isinstance(obj[\"path\"], str):\n            paths.append(obj[\"path\"])\n        else:\n            for k in sorted(obj.keys()):\n                find_paths(obj[k])\n    elif isinstance(obj, list):\n        for v in obj:\n            find_paths(v)\nfind_paths(reads)\nfwd = paths[0] if len(paths) > 0 else None\nrev = paths[1] if len(paths) > 1 else None\n\nif not fwd or not rev:\n    print(f\"Error: Unable to identify forward and reverse read paths from input: {reads}\", file=sys.stderr)\n    sys.exit(1)\n\nidx = params[\"index\"]\nt2g = params[\"t2g\"]\ntech = params.get(\"technology\") or \"10XV2\"\nwf = params.get(\"workflow_mode\") or \"standard\"\nwl = params.get(\"whitelist\")\nslots = os.environ.get(\"GALAXY_SLOTS\", \"4\")\n\ncmd = [\"kb\", \"count\", \"-t\", str(slots), \"-i\", idx, \"-g\", t2g, \"-x\", tech, \"--workflow\", wf]\nif wl and os.path.exists(wl):\n    cmd.extend([\"-w\", wl])\ncmd.extend([\"-o\", \"output_counts\", fwd, rev])\nprint(\"Running kb count:\", \" \".join(cmd))\nres = subprocess.run(cmd)\nif res.returncode != 0:\n    sys.exit(res.returncode)\n\nos.makedirs(\"out_solo/raw\", exist_ok=True)\nos.makedirs(\"out_solo/filtered\", exist_ok=True)\n\nfor pattern, dst in [\n    (\"output_counts/counts_unfiltered/*.mtx\", \"out_solo/raw/matrix.mtx\"),\n    (\"output_counts/counts_unfiltered/*.barcodes.txt\", \"out_solo/raw/barcodes.tsv\"),\n    (\"output_counts/counts_unfiltered/*.genes.txt\", \"out_solo/raw/features.tsv\"),\n    (\"output_counts/counts_filtered/*.mtx\", \"out_solo/filtered/matrix.mtx\"),\n    (\"output_counts/counts_filtered/*.barcodes.txt\", \"out_solo/filtered/barcodes.tsv\"),\n    (\"output_counts/counts_filtered/*.genes.txt\", \"out_solo/filtered/features.tsv\")\n]:\n    matches = glob.glob(pattern)\n    if matches:\n        shutil.copyfile(matches[0], dst)\n\n# Ensure filtered outputs exist even if kb count ran in unfiltered-only mode or minimal test data\nif not os.path.exists(\"out_solo/filtered/matrix.mtx\") and os.path.exists(\"out_solo/raw/matrix.mtx\"):\n    shutil.copyfile(\"out_solo/raw/matrix.mtx\", \"out_solo/filtered/matrix.mtx\")\nif not os.path.exists(\"out_solo/filtered/barcodes.tsv\") and os.path.exists(\"out_solo/raw/barcodes.tsv\"):\n    shutil.copyfile(\"out_solo/raw/barcodes.tsv\", \"out_solo/filtered/barcodes.tsv\")\nif not os.path.exists(\"out_solo/filtered/features.tsv\") and os.path.exists(\"out_solo/raw/features.tsv\"):\n    shutil.copyfile(\"out_solo/raw/features.tsv\", \"out_solo/filtered/features.tsv\")\n"
          }
        ],
        "shell_command": "set -euo pipefail\npython3 run_kb.py\n",
        "inputs": [
          {
            "name": "reads",
            "type": "data_collection",
            "collection_type": "paired",
            "label": "Paired Single-Cell Reads (Read 1 Barcode/UMI, Read 2 cDNA)"
          },
          {
            "name": "index",
            "type": "data",
            "format": "binary",
            "label": "Kallisto Index (.idx)"
          },
          {
            "name": "t2g",
            "type": "data",
            "format": "tabular",
            "label": "Transcript-to-Gene Mapping (t2g.txt)"
          },
          {
            "name": "whitelist",
            "type": "data",
            "format": "txt,tabular",
            "optional": true,
            "label": "Cell Barcode Whitelist"
          },
          {
            "name": "technology",
            "type": "text",
            "value": "10XV2",
            "label": "Single-Cell Technology / Chemistry"
          },
          {
            "name": "workflow_mode",
            "type": "text",
            "value": "standard",
            "label": "Workflow Mode"
          }
        ],
        "outputs": [
          {
            "name": "raw_matrix",
            "type": "data",
            "format": "mtx",
            "from_work_dir": "out_solo/raw/matrix.mtx",
            "label": "Raw Count Matrix (MTX)"
          },
          {
            "name": "raw_barcodes",
            "type": "data",
            "format": "tsv",
            "from_work_dir": "out_solo/raw/barcodes.tsv",
            "label": "Raw Cell Barcodes (TSV)"
          },
          {
            "name": "raw_features",
            "type": "data",
            "format": "tsv",
            "from_work_dir": "out_solo/raw/features.tsv",
            "label": "Raw Gene Features (TSV)"
          },
          {
            "name": "filtered_matrix",
            "type": "data",
            "format": "mtx",
            "from_work_dir": "out_solo/filtered/matrix.mtx",
            "label": "Filtered Count Matrix (MTX)"
          },
          {
            "name": "filtered_barcodes",
            "type": "data",
            "format": "tsv",
            "from_work_dir": "out_solo/filtered/barcodes.tsv",
            "label": "Filtered Cell Barcodes (TSV)"
          },
          {
            "name": "filtered_features",
            "type": "data",
            "format": "tsv",
            "from_work_dir": "out_solo/filtered/features.tsv",
            "label": "Filtered Gene Features (TSV)"
          }
        ],
        "help": {
          "format": "markdown",
          "content": "Quantifies single-cell RNA-seq FASTQ reads into gene expression matrices using kb count.\n"
        }
      }
    },
    "8": {
      "id": 8,
      "name": "Convert 10x MTX to AnnData H5AD",
      "type": "tool",
      "label": "mtx_to_h5ad",
      "annotation": "Convert count matrices to AnnData H5AD format",
      "tool_state": "{\"__page__\": 0}",
      "position": {
        "left": 1570,
        "top": 50
      },
      "input_connections": {
        "matrix": [
          {
            "id": 7,
            "output_name": "raw_matrix"
          }
        ],
        "barcodes": [
          {
            "id": 7,
            "output_name": "raw_barcodes"
          }
        ],
        "features": [
          {
            "id": 7,
            "output_name": "raw_features"
          }
        ]
      },
      "inputs": [],
      "outputs": [],
      "workflow_outputs": [
        {
          "label": "Per-Sample Filtered AnnData Matrix",
          "output_name": "h5ad"
        }
      ],
      "post_job_actions": {},
      "tool_representation": {
        "class": "GalaxyUserTool",
        "name": "Convert 10x MTX to AnnData H5AD",
        "id": "mtx-to-h5ad",
        "version": "0.1.0",
        "description": "Convert 10x Genomics MTX matrix, barcodes, and features into an AnnData H5AD object",
        "container": "quay.io/biocontainers/scanpy:1.7.2--pyhdfd78af_0",
        "configfiles": [
          {
            "filename": "params.json",
            "content": "{\n  \"matrix\": $(JSON.stringify(inputs.matrix.path)),\n  \"barcodes\": $(JSON.stringify(inputs.barcodes.path)),\n  \"features\": $(JSON.stringify(inputs.features.path)),\n  \"sample\": $(JSON.stringify(inputs.sample_name)),\n  \"input_type\": $(JSON.stringify(inputs.input_type))\n}\n"
          },
          {
            "filename": "convert.py",
            "content": "import os\nimport json\nimport gzip\nimport shutil\nimport scanpy as sc\n\nwith open(\"params.json\") as fh:\n    params = json.load(fh)\n\nsample = params.get(\"sample\") or \"sample\"\ninput_type = params.get(\"input_type\") or \"filtered\"\n\nmtx_dir = \"solo_mtx_input\"\nos.makedirs(mtx_dir, exist_ok=True)\n\ndef setup_input(src, base_name):\n    dest_gz = os.path.join(mtx_dir, f\"{base_name}.gz\")\n    if os.path.exists(dest_gz):\n        os.remove(dest_gz)\n    with open(src, \"rb\") as f:\n        magic = f.read(2)\n    if magic == b\"\\x1f\\x8b\":\n        os.symlink(os.path.abspath(src), dest_gz)\n    else:\n        with open(src, \"rb\") as f_in, gzip.open(dest_gz, \"wb\") as f_out:\n            shutil.copyfileobj(f_in, f_out)\n\nsetup_input(params[\"matrix\"], \"matrix.mtx\")\nsetup_input(params[\"barcodes\"], \"barcodes.tsv\")\n\nfeat_src = params[\"features\"]\nwith open(feat_src, \"rb\") as f:\n    is_gz = f.read(2) == b\"\\x1f\\x8b\"\nif is_gz:\n    with gzip.open(feat_src, \"rt\") as f:\n        lines = f.readlines()\nelse:\n    with open(feat_src, \"rt\") as f:\n        lines = f.readlines()\n\nfirst_cols = lines[0].strip().split(\"\\t\") if lines else []\nif len(first_cols) == 1:\n    print(\"Detected 1-column features list (Kallisto/Bustools format). Reading directly via sc.read_mtx...\")\n    adata = sc.read_mtx(params[\"matrix\"])\n    barcodes_src = params[\"barcodes\"]\n    with open(barcodes_src, \"rb\") as bf:\n        b_gz = bf.read(2) == b\"\\x1f\\x8b\"\n    if b_gz:\n        with gzip.open(barcodes_src, \"rt\") as bf:\n            barcodes_list = [l.strip() for l in bf if l.strip()]\n    else:\n        with open(barcodes_src, \"rt\") as bf:\n            barcodes_list = [l.strip() for l in bf if l.strip()]\n    features_list = [l.strip() for l in lines if l.strip()]\n    if adata.shape == (len(barcodes_list), len(features_list)):\n        adata.obs_names = barcodes_list\n        adata.var_names = features_list\n    elif adata.shape == (len(features_list), len(barcodes_list)):\n        adata = adata.T\n        adata.obs_names = barcodes_list\n        adata.var_names = features_list\n    else:\n        print(f\"Warning: dimension mismatch {adata.shape} vs ({len(barcodes_list)}, {len(features_list)})\")\n        adata.obs_names = [f\"cell_{i}\" for i in range(adata.n_obs)]\n        adata.var_names = [f\"gene_{i}\" for i in range(adata.n_vars)]\n    adata.obs[\"sample\"] = sample\n    adata.layers[\"count\"] = adata.X.copy()\n    adata.var[\"gene_ids\"] = adata.var_names\n    adata.var[\"gene_symbol\"] = adata.var_names\n    adata.var[\"gene_versions\"] = adata.var_names\n    adata.var.index = adata.var[\"gene_versions\"].str.split(\".\").str[0].values\n    adata.var_names_make_unique()\nelse:\n    setup_input(feat_src, \"features.tsv\")\n    print(f\"Reading 10x MTX from {mtx_dir} for sample {sample} ({input_type})...\")\n    adata = sc.read_10x_mtx(mtx_dir)\n    adata.obs[\"sample\"] = sample\n    adata.layers[\"count\"] = adata.X.copy()\n    adata.var[\"gene_symbol\"] = adata.var.index\n    adata.var[\"gene_versions\"] = adata.var[\"gene_ids\"]\n    adata.var.index = adata.var[\"gene_versions\"].str.split(\".\").str[0].values\n    adata.var_names_make_unique()\n\nout_file = \"matrix.h5ad\"\nadata.write_h5ad(out_file)\nprint(f\"Successfully wrote AnnData ({adata.n_obs} cells x {adata.n_vars} genes) to {out_file}\")\n"
          }
        ],
        "shell_command": "python convert.py",
        "inputs": [
          {
            "name": "matrix",
            "type": "data",
            "format": "mtx",
            "label": "Count Matrix (MTX)"
          },
          {
            "name": "barcodes",
            "type": "data",
            "format": "tabular,txt",
            "label": "Barcodes (TSV)"
          },
          {
            "name": "features",
            "type": "data",
            "format": "tabular,txt",
            "label": "Features / Genes (TSV)"
          },
          {
            "name": "sample_name",
            "type": "text",
            "value": "sample",
            "label": "Sample Identifier"
          },
          {
            "name": "input_type",
            "type": "text",
            "value": "filtered",
            "label": "Matrix Type (raw or filtered)"
          }
        ],
        "outputs": [
          {
            "name": "h5ad",
            "type": "data",
            "format": "h5ad",
            "from_work_dir": "matrix.h5ad",
